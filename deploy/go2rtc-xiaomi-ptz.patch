+
+// Motorer is a source that can move its camera one pan/tilt step, and report
+// the current position. Duck-typed so this module doesn't import pkg/xiaomi.
+type Motorer interface {
+	PTZState() miss.PTZState
+	Move(direction string) error
+	RefreshPosition(ctx context.Context) (*miss.PTZPosition, error)
+}
+
+// Motor moves the camera behind stream `name` one step, or reads its current
+// position when `read` is set. It uses the session the stream already holds,
+// so the stream must be running (someone consuming it).
+func Motor(name string, operation int) error {
+	stream := streams.Get(name)
+	if stream == nil {
+		return fmt.Errorf("xiaomi: motor: no stream %q", name)
+	}
+	for _, conn := range stream.Conns() {
+		if m, ok := conn.(Motorer); ok {
+			return m.Move(operationName(operation))
+		}
+	}
+	return fmt.Errorf("xiaomi: motor: stream %q has no connected source with a motor", name)
+}
+
+func operationName(op int) string {
+	switch op {
+	case 1:
+		return "left"
+	case 2:
+		return "right"
+	case 3:
+		return "up"
+	case 4:
+		return "down"
+	}
+	return fmt.Sprintf("%d", op)
+}
+
+// apiMotor:
+//
+//	POST /api/xiaomi/motor?src=<stream>&operation=<1 left|2 right|3 up|4 down>
+//	GET  /api/xiaomi/motor?src=<stream>&read=1   -> current position
+func apiMotor(w http.ResponseWriter, r *http.Request) {
+	src := r.URL.Query().Get("src")
+	stream := streams.Get(src)
+	if stream == nil {
+		http.Error(w, fmt.Sprintf("xiaomi: motor: no stream %q", src), http.StatusNotFound)
+		return
+	}
+
+	// Find a connected motor source on this stream.
+	var ctrl Motorer
+	for _, conn := range stream.Conns() {
+		if m, ok := conn.(Motorer); ok {
+			ctrl = m
+			break
+		}
+	}
+	if ctrl == nil {
+		http.Error(w, fmt.Sprintf("xiaomi: motor: stream %q has no connected source with a motor", src), http.StatusNotFound)
+		return
+	}
+
+	switch r.Method {
+	case "GET":
+		if r.URL.Query().Get("read") != "" {
+			ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+			defer cancel()
+			position, err := ctrl.RefreshPosition(ctx)
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			api.ResponseJSON(w, position)
+			return
+		}
+		state := ctrl.PTZState()
+		api.ResponseJSON(w, state)
+
+	case "POST":
+		operation := r.URL.Query().Get("operation")
+		if operation == "" {
+			http.Error(w, "missing operation (1 left, 2 right, 3 up, 4 down)", http.StatusBadRequest)
+			return
+		}
+		if err := ctrl.Move(operationName(int(mustAtoi(operation)))); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		api.ResponseJSON(w, map[string]any{"ok": true, "operation": operation})
+
+	default:
+		http.Error(w, "GET or POST only", http.StatusMethodNotAllowed)
+	}
+}
+
+func mustAtoi(s string) int {
+	n, _ := strconv.Atoi(s)
+	return n
 }
 
